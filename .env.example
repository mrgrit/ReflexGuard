# Documentation only. Export these in your shell; this file is not auto-loaded.
# Generate API tokens at runtime with secrets.token_urlsafe(32).
REFLEXGUARD_API_TOKENS=
REFLEXGUARD_BRAIN_TOKEN=
REFLEXGUARD_BRAIN_URL=https://localhost:8443
REFLEXGUARD_TLS_CA=certs/ca.crt
REFLEXGUARD_TLS_SERVER_CERT=certs/server.crt
REFLEXGUARD_TLS_SERVER_KEY=certs/server.key
REFLEXGUARD_TLS_CLIENT_CERT=certs/client.crt
REFLEXGUARD_TLS_CLIENT_KEY=certs/client.key
REFLEXGUARD_MOCK_PORT=8443

# Future MaleCNS import only; separate from the brain API token.
REFLEXGUARD_NEUPRINT_TOKEN=

# Phase 4: scripts/init_control.sh generates Git-ignored .env.control and .env.admin.
# REFLEXGUARD_CONTROL_URL=https://localhost:8444
# REFLEXGUARD_CONTROL_PORT=8444
# REFLEXGUARD_CONTROL_HOST=0.0.0.0
# For direct LAN access, CONTROL_URL must match the browser's HTTPS origin.
# Use a dashboard certificate whose SAN contains that IP or DNS name.
# REFLEXGUARD_CONTROL_TLS_CERT=certs/control-lan/server.crt
# REFLEXGUARD_CONTROL_TLS_KEY=certs/control-lan/server.key
# REFLEXGUARD_CONTROL_DB=control.db
# REFLEXGUARD_CONTROL_DEVICES=[{"chair_id":"seat-a","token":"<generated>","hmac_key":"<generated>"}]
# REFLEXGUARD_AUDIT_KEY=<generated separately>
# Device only: REFLEXGUARD_CHAIR_ID, REFLEXGUARD_DEVICE_TOKEN, REFLEXGUARD_REMOTE_KEY
